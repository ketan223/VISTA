# VISTA Environment Configuration
# Copy this file to .env to configure local settings

# Speech-to-Text Whisper Settings
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# LLM Settings (Ollama is default and runs locally without API keys)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Google Gemini API (Used for AI Chat Assistant)
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash

# Optional Cloud LLM (Mistral API)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional Web Search API
TAVILY_API_KEY=

# Optional Cloud Indian STT (Sarvam AI for specialized Indic transcription)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v2.5

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
